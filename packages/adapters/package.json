{
  "name": "@xpensego/adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./cloudflare/console-runtime-telemetry": "./src/cloudflare/console-runtime-telemetry.ts",
    "./cloudflare/runtime-config": "./src/cloudflare/runtime-config.ts",
    "./postgres/inbound-event-store": "./src/postgres/inbound-event-store.ts",
    "./postgres/isolated-test-database": "./src/postgres/isolated-test-database.ts",
    "./postgres/migrations": "./src/postgres/migrations.ts",
    "./postgres/outbox-store": "./src/postgres/outbox-store.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "tsx src/postgres/migrate.ts",
    "db:outbox:retry": "tsx src/postgres/recover-outbox.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@effect/experimental": "0.61.1",
    "@effect/platform": "0.97.1",
    "@effect/sql": "0.52.1",
    "@effect/sql-pg": "0.53.0",
    "@xpensego/domain": "0.1.0",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@effect/platform-node": "0.108.1",
    "@xpensego/config": "0.1.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
