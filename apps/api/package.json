{
  "name": "@xpensego/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "deploy:staging": "wrangler deploy --env staging",
    "dev": "wrangler dev",
    "proof:phase1:staging": "tsx scripts/phase1-staging-proof.ts",
    "proof:model:staging": "tsx scripts/model-gateway-staging-proof.ts",
    "operator:telegram:recover": "tsx scripts/recover-telegram-delivery.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "npm run types && tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "types": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@effect/platform": "0.97.1",
    "@xpensego/adapters": "0.1.0",
    "@xpensego/contracts": "0.1.0",
    "@xpensego/domain": "0.1.0",
    "@xpensego/testing": "0.1.0",
    "effect": "3.22.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@effect/platform-node": "0.108.1",
    "@effect/sql-pg": "0.53.0",
    "@xpensego/config": "0.1.0",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10",
    "wrangler": "4.120.0"
  }
}
